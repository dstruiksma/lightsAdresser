<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces the lights API on the LAN so the app can find it (DNS-SD).
     Installed with @ID@ replaced by the last 4 hex digits of the wlan0 MAC,
     the same id the Wi-Fi setup hotspot uses (Lights-Setup-@ID@). -->
<service-group>
  <name>Lights @ID@</name>
  <service>
    <type>_lights._tcp</type>
    <port>5000</port>
    <txt-record>id=@ID@</txt-record>
    <txt-record>api=2</txt-record>
  </service>
</service-group>
