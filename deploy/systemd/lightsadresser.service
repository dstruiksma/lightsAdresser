[Unit]
Description=Lights Adresser Flask API
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/lightAdresser
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/lightAdresser/.venv/bin/python /home/pi/lightAdresser/lights_api.py
Restart=always
RestartSec=5
MemoryMax=120M
MemoryHigh=100M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
