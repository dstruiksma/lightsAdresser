[Unit]
Description=Lights HTTP API (stdlib server)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# rpi_ws281x drives GPIO18 through /dev/mem and needs root.
User=root
WorkingDirectory=/opt/lights
Environment=PYTHONUNBUFFERED=1
Environment=LIGHTS_PORT=5000
ExecStart=/opt/lights/.venv/bin/python /opt/lights/server.py
Restart=always
RestartSec=3
MemoryMax=80M
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
